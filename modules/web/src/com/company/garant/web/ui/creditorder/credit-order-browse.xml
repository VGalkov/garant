<window
        xmlns="http://schemas.haulmont.com/cuba/window.xsd"
        xmlns:thesis="http://schemas.haulmont.com/thesis/thesis-window.xsd"
        class="com.company.garant.web.ui.creditorder.CreditOrderBrowse"
        extends="com/haulmont/thesis/web/ui/simpledoc/simple-doc-browse.xml"
        caption="msg://creditOrderBrowse.caption"
        messagesPack="com.company.garant.web.ui.creditorder">
    <dsContext>
        <groupDatasource id="cardsDs" class="com.company.garant.entity.CreditOrder" view="edit">
            <query>
                <![CDATA[select distinct d from garant$CreditOrder d
                where d.template = false and d.versionOf is null and d.isArchivedDoc = false
                order by d.dateTime]]>
                <filter>
                    <and>
                        <c><![CDATA[d.id <> :param$exclItem]]></c>
                        <c>
                            <![CDATA[d.imported = true and d.createTs >= :param$startCreateTs and d.createTs <= :param$endCreateTs]]></c>
                        <c><![CDATA[d.packageDoc is null and :param$exclPackageDocExists = 1]]></c>
                        <c><![CDATA[d.contractor.id = :param$contractor]]></c>
                        <c><![CDATA[d.edmInbound = :param$edmInbound]]></c>
                    </and>
                </filter>
            </query>
        </groupDatasource>
    </dsContext>


    <dialogMode height="600" width="800"/>
    <layout>
        <vbox >
            <hbox>
                <filter id="genericFilter" enable="false"/>
            </hbox>

            <split id="split">
                <vbox id="table-panel">
                    <groupTable id="cardsTable">
                        <buttonsPanel id="buttonsPanel">
                            <popupButton id="createButton" />
                            <button id="createDocBtn" />
                            <thesis:separator/>
                            <button id="editBtn" />
                            <button id="removeBtn" />
                            <button id="saveAsTemplateBtn" />
                            <thesis:separator/>
                            <button id="refreshBtn"/>
                            <button id="excel"/>
                            <button id="expandBtn"/>
                            <runReportPopupButton id="printButton" />
                        </buttonsPanel>
                        <actions>
                            <action id="create"/>
                            <action id="edit"/>
                            <action id="remove"/>
                            <action id="saveAsTemplate" />
                            <action id="deleteNotification"/>
                            <action id="openNewTab"/>
                            <action id="showLink"/>
                            <action id="expand"/>
                        </actions>
                        <rowsCount/>
                        <tableSettings id="tableSettings"/>
                        <columns includeAll="false">
                            <column id="credit" />
                            <column id="docKind"/>
                            <column id="docCategory"/>
                            <column id="workingType"/>
                            <column id="contractor"/>
                            <column id="date"/>
                            <column id="number"/>
                        </columns>
                        <rows datasource="cardsDs"/>
                    </groupTable>
                </vbox>
                <vbox id="cardDetailsTabSheetBox" />
            </split>
        </vbox>
    </layout>
</window>
