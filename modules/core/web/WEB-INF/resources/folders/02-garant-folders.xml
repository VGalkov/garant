<folders xmlns="http://schemas.haulmont.com/thesis/4.0/folders.xsd">
    <!-- OnlineOrders folders-->
    <folder>
        <name>AppFolder_OnlineCreditOrder.onlineorders</name>
        <sortOrder>-1</sortOrder>
        <roles>
            <role>Administrators</role>
            <role>doc_initiator</role>
        </roles>
    </folder>

    <folder> <!-- переделать на скрипты.. хотя не нужное усложнение функционала -->
        <name>AppFolder_OnlineCreditOrder.newonlineorder</name>
        <sortOrder>1</sortOrder>
        <entity>garant$CreditOrder</entity>
        <parent>AppFolder_OnlineCreditOrder.onlineorders</parent>
        <roles>
            <role>Administrators</role>
            <role>doc_initiator</role>
            <role>Оператор</role>
            <role>Менеджер</role>
        </roles>
        <conditions>
            <condition>
                <process>OnlineCreditOrderProcess</process>
                <states>
                    <state>Started</state>
                </states>
            </condition>
        </conditions>
    </folder>

    <folder> <!-- переделать на скрипты.. хотя не нужное усложнение функционала -->
        <name>AppFolder_OnlineCreditOrder.inworkonlineorder</name>
        <sortOrder>2</sortOrder>
        <entity>garant$CreditOrder</entity>
        <parent>AppFolder_OnlineCreditOrder.onlineorders</parent>
        <roles>
            <role>Administrators</role>
            <role>doc_initiator</role>
            <role>legalDepartment</role>
            <role>securityDepartment</role>
            <role>Оператор</role>
            <role>Менеджер</role>
        </roles>
        <conditions>
            <condition>
                <process>OnlineCreditOrderProcess</process>
                <states>
                    <state>Ne_soglasovano_uridicheskoi_sluzhboi</state>
                    <state>Soglasovanie</state>
                    <state>Parallelnoe_naznachenie3</state>
                    <state>Vydacha_kredita</state>
                    <state>Proverka_pogasheniya</state>
                    <state>Uvedomlenie_SB</state>
                    <state>Proverka</state>
                    <state>Ne_soglasovano_bankom</state>
                    <state>Proverka_SB</state>
                    <state>Ne_soglasovano_SB</state>
                    <state>Proverka_zayavki_ne_proidena</state>
                    <state>Pogashenie_kredita</state>
                </states>
            </condition>
        </conditions>
    </folder>
</folders>

